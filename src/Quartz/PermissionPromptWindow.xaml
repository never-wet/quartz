<Window x:Class="Quartz.PermissionPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site permission - Quartz"
        Width="430"
        Height="235"
        MinWidth="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource QuartzCanvasBrush}"
        TextElement.Foreground="{DynamicResource QuartzTextBrush}"
        ShowInTaskbar="False">
    <Border Margin="14" Style="{StaticResource PanelCardStyle}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Site permission request" />
            <TextBlock x:Name="RequestText" Grid.Row="1" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="OriginText" Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource QuartzMutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="90" Height="32" Margin="0,0,8,0" Style="{StaticResource QuartzButtonStyle}" Content="Block" IsCancel="True" Click="BlockButton_Click" />
                <Button Width="90" Height="32" Style="{StaticResource AccentButtonStyle}" Content="Allow" IsDefault="True" Click="AllowButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
