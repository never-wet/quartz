<Application x:Class="Quartz.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="QuartzCanvasBrush" po:Freeze="False" Color="#FFF5F4F8" />
        <SolidColorBrush x:Key="QuartzSurfaceBrush" po:Freeze="False" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="QuartzRaisedBrush" po:Freeze="False" Color="#FFFAF9FC" />
        <SolidColorBrush x:Key="QuartzTextBrush" po:Freeze="False" Color="#FF25232B" />
        <SolidColorBrush x:Key="QuartzMutedTextBrush" po:Freeze="False" Color="#FF6F6B78" />
        <SolidColorBrush x:Key="QuartzBorderBrush" po:Freeze="False" Color="#FFDDD9E4" />
        <SolidColorBrush x:Key="QuartzAddressBrush" po:Freeze="False" Color="#FFF7F6FA" />
        <SolidColorBrush x:Key="QuartzTabStripBrush" po:Freeze="False" Color="#FFEDEAF3" />
        <SolidColorBrush x:Key="QuartzSidebarBrush" po:Freeze="False" Color="#FFF0EDF6" />
        <SolidColorBrush x:Key="QuartzProgressTrackBrush" po:Freeze="False" Color="#FFE8E5ED" />
        <SolidColorBrush x:Key="QuartzAccentBrush" po:Freeze="False" Color="#FF765CB2" />
        <SolidColorBrush x:Key="QuartzAccentHoverBrush" po:Freeze="False" Color="#FF684DA7" />
        <SolidColorBrush x:Key="QuartzAccentSoftBrush" po:Freeze="False" Color="#FFE8E2F2" />
        <SolidColorBrush x:Key="QuartzHoverBrush" po:Freeze="False" Color="#FFEDEAF3" />
        <SolidColorBrush x:Key="QuartzPressedBrush" po:Freeze="False" Color="#FFE1DCEB" />
        <SolidColorBrush x:Key="QuartzPrivateBrush" po:Freeze="False" Color="#FF4D3A68" />
        <SolidColorBrush x:Key="QuartzPrivateTextBrush" po:Freeze="False" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="QuartzOnAccentBrush" po:Freeze="False" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="QuartzDangerBrush" po:Freeze="False" Color="#FFB23A48" />
        <SolidColorBrush x:Key="QuartzWarningBrush" po:Freeze="False" Color="#FF946814" />
        <SolidColorBrush x:Key="QuartzSecureBrush" po:Freeze="False" Color="#FF287A55" />
        <SolidColorBrush x:Key="QuartzTooltipBrush" po:Freeze="False" Color="#FF29262F" />
        <SolidColorBrush x:Key="QuartzTooltipTextBrush" po:Freeze="False" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="QuartzFieldTextBrush" po:Freeze="False" Color="#FF25232B" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource QuartzCanvasBrush}" />
        </Style>

        <Style x:Key="QuartzButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource QuartzRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource QuartzHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource QuartzPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource QuartzButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource QuartzButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource QuartzOnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource QuartzAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AccentBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccentBorder" Property="Background" Value="{DynamicResource QuartzAccentHoverBrush}" />
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource QuartzAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AccentBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource QuartzButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ToolTipService.ShowDuration" Value="3000" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MaxWidth" Value="225" />
            <Setter Property="Height" Value="33" />
            <Setter Property="Margin" Value="2,2,0,0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Foreground" Value="{DynamicResource QuartzMutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="9,9,0,0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActiveIndicator"
                                    Height="3"
                                    Margin="10,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource QuartzAccentBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource QuartzHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="2" />
                                <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource QuartzSurfaceBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddressBarStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource QuartzAddressBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="AddressBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="AddressBorder" Property="Background" Value="{DynamicResource QuartzSurfaceBrush}" />
                                <Setter TargetName="AddressBorder" Property="BorderBrush" Value="{DynamicResource QuartzAccentBrush}" />
                                <Setter TargetName="AddressBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource QuartzCanvasBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource QuartzSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PanelHeaderStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{DynamicResource QuartzSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="PanelCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource QuartzAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource QuartzProgressTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource QuartzTooltipBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource QuartzTooltipTextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource QuartzButtonStyle}" />

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource QuartzAddressBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource QuartzFieldTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource QuartzAddressBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource QuartzSurfaceBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource QuartzAccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource QuartzAccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource QuartzAccentSoftBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource QuartzAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuartzBorderBrush}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource QuartzHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource QuartzAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource QuartzTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
