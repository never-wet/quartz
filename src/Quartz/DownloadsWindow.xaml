<Window x:Class="Quartz.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads - Quartz"
        Width="760"
        Height="500"
        MinWidth="560"
        MinHeight="320"
        Background="{DynamicResource QuartzCanvasBrush}"
        TextElement.Foreground="{DynamicResource QuartzTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DownloadsHeading" Text="Downloads" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="PrivateDownloadNotice"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource QuartzMutedTextBrush}"
                               FontSize="11"
                               Text="Private records are removed when this window closes; downloaded files remain on disk."
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource QuartzButtonStyle}"
                        Content="Clear completed"
                        Click="ClearCompleted_Click" />
            </Grid>
        </Border>

        <ListBox x:Name="DownloadsItems"
                 Grid.Row="1"
                 Margin="14"
                 Padding="0"
                 ItemsSource="{Binding Downloads}"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,9" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{DynamicResource QuartzMutedTextBrush}" Text="{Binding Status}" />
                            </Grid>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource QuartzMutedTextBrush}" Text="{Binding ProgressText}" />
                            <ProgressBar Height="5" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                            <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource QuartzMutedTextBrush}" Text="{Binding SavePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SavePath}" />
                            <WrapPanel Margin="0,9,0,0">
                                <Button Content="Open file" Tag="{Binding}" Margin="0,0,7,0" Click="OpenFile_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuartzButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="Open folder" Tag="{Binding}" Margin="0,0,7,0" Click="OpenFolder_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuartzButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="Cancel" Tag="{Binding}" Click="Cancel_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuartzButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
